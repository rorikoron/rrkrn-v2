{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "rrkrn-v2",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Workaround for https://github.com/opennextjs/opennextjs-cloudflare/issues/1232
    // Next's getMiddlewareManifest() does `require()` with a dynamic path when
    // minimalMode is false, which Workers can't support. This project has no
    // middleware.ts, so forcing minimal mode is safe.
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "rrkrn-v2",
    },
  ],
  "r2_buckets": [
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "rrkrn-cache-bucket",
      "remote": true
    },
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "rrkrn-archive-bucket",
      "remote": true
    },
  ],
  "d1_databases": [
    {
      "binding": "BOOTH_ITEM_LIST",
      "database_name": "booth-item-list",
      "database_id": "dc80000a-a609-473b-964c-ab2c736a4899",
      "remote": true
    },
  ],
}